# What Cloud Build does *not* need to upload.
#
# gcloud reads this file, not `.dockerignore` — the two are separate, and
# without this the build context was 369 MB of mostly `node_modules`, uploaded
# from a laptop on every build.
.git/
.gitignore

# Node and Flutter dependency trees: both are reinstalled inside their own
# builds and neither is part of the backend image.
dashboard/node_modules/
dashboard/dist/
app/build/
app/.dart_tool/
app/.pub-cache/

# The on-device speech models. 243 MB of ONNX — whisper-tiny and
# IndicConformer — that exist to run inference on the phone, and which this
# image never opens: every model the backend uses is a Vertex call. They were
# most of a 268 MB source tarball uploaded to Cloud Build on every backend
# deploy.
app/assets/asr/

# The kiosk tablet's Flutter app. Its build output is ~1 GB of Gradle and NDK
# intermediates, and `.gitignore` hiding them is no help here — gcloud reads
# this file and nothing else, so one `flutter build apk` turned a 36 MB source
# upload into a 1 GB one.
jetson/medikiosk_flutter/build/
jetson/medikiosk_flutter/.dart_tool/
jetson/tablet_app/.buildozer/
jetson/tablet_app/bin/

__pycache__/
*.pyc
.venv/
backend/.venv/
backend/uploads/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local state that must never reach a build, let alone an image.
.env
*.local
