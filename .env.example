# Copy to .env and fill in. Never commit a filled-in .env — `.gitignore` blocks
# it, and that block is load-bearing.
#
# There is no default password and no default token anywhere in this repository.
# `docker compose up` fails to start rather than booting with a credential that
# is written down in a public repo. Two variables have no default and must be
# set before the stack will come up: POSTGRES_PASSWORD and KIOSK_TOKENS.
#
# Every name below is read by `backend/app/core/config.py`. If you add one here,
# add it there too — a variable that only exists in this file is a setting
# somebody will set and then wonder why nothing changed.

# --- compose only -----------------------------------------------------------
# These configure the Postgres container and the published ports. The
# application never reads them; it reads DATABASE_URL, which compose builds.
POSTGRES_USER=medikiosk
POSTGRES_PASSWORD=
POSTGRES_DB=medikiosk
POSTGRES_PORT=5432
API_PORT=8000
WORKER_PORT=8001

# --- environment ------------------------------------------------------------
ENVIRONMENT=local
DEBUG=false
# The facility's own timezone. Report dates are the hospital's calendar day,
# never the server's UTC day — an evening OPD in IST files under yesterday
# otherwise.
FACILITY_TIMEZONE=Asia/Kolkata

# --- persistence ------------------------------------------------------------
# Set for a host-run backend. Under compose this is built from POSTGRES_* above
# and this value is ignored.
DATABASE_URL=postgresql+asyncpg://medikiosk:CHANGE_ME@localhost:5432/medikiosk
DATABASE_ECHO=false

# --- clinical content -------------------------------------------------------
CLINICAL_CONTENT_DIR=./clinical
# JSON list. A language is only offered if templates exist for it: the report is
# written once per language and never machine-translated at runtime.
REPORT_LANGUAGES=["en","hi"]
# Fallback only. A report is rendered in the patient's own language when one was
# recorded.
DEFAULT_REPORT_LANGUAGE=en

# --- object storage ---------------------------------------------------------
# local | gcs
STORAGE_BACKEND=local
DOCUMENT_STORAGE_DIR=./backend/uploads
GCS_BUCKET=
# Short by policy. A document link that outlives the consultation is a document
# link that ends up in a WhatsApp group.
SIGNED_URL_TTL_SECONDS=300

# --- OCR --------------------------------------------------------------------
# mock | gemini. Every test and the offline demo run mock.
OCR_PROVIDER=mock
# Model ids are config, never inline, so swapping a model is a deployment
# change rather than a code change.
OCR_MODEL_ID=
# Any digit in a dose or a lab value read below this is flagged for the
# physician rather than shown as fact. The benchmark read ९००.२ for १००.२.
OCR_CONFIDENCE_FLOOR=0.85
# Below this the image is rejected outright and a reshoot is requested.
OCR_QUALITY_FLOOR=0.35

# --- repair (the one place a language model touches clinical input) ---------
# mock | vertex | none
REPAIR_PROVIDER=mock
REPAIR_MODEL_ID=
REPAIR_MAX_ATTEMPTS=1

# --- Vertex -----------------------------------------------------------------
VERTEX_PROJECT=
# asia-south1 | asia-south2. The Gemini adapter refuses to construct outside
# these.
VERTEX_REGION=asia-south1
# Must be true before any Vertex call is made in an environment holding real
# patient data, and the residency question behind it is still open. See
# docs/DECISIONS.md.
VERTEX_ZDR_ENABLED=false

# --- identity ---------------------------------------------------------------
# mock | sandbox. The mock stamps "source": "mock" on every response and the API
# surfaces it, so a mocked government integration is never presented as live.
ABHA_PROVIDER=mock
ABDM_BASE_URL=

# --- demo -------------------------------------------------------------------
# Serves cached OCR for the fixture documents and marks every response
# "demo": true.
DEMO_MODE=false

# --- document queue ---------------------------------------------------------
# Where a newly uploaded document's OCR work goes.
#   inline  a background task in this process. No broker; this is the demo path.
#   pubsub  a message to PUBSUB_TOPIC, read by a separate Cloud Run worker.
# Both end at the same DocumentService.process, so the two cannot drift.
DOCUMENT_QUEUE=inline
# The project holding the topic and the bucket. Vertex has its own setting, so
# model calls and patient data can live in different projects.
GCP_PROJECT=
PUBSUB_TOPIC=
# Registers POST /api/v1/worker/documents. Off on the public API service: the
# worker is a separate deployment of the same image, so the route exists only
# where it is meant to be reachable.
PUBSUB_PUSH_ENABLED=false
# Shared secret the push subscription presents, behind Cloud Run's own IAM
# check. In the cloud this comes from Secret Manager and is never set here.
PUBSUB_PUSH_TOKEN=
WEBSOCKET_HEARTBEAT_SECONDS=20

# --- auth -------------------------------------------------------------------
# JSON object, {"<token>": "<hospital_id>"}. One entry per kiosk device. The
# token's hospital wins over anything in the request body, so a misconfigured
# device cannot write into another hospital's data. In the cloud this comes from
# Secret Manager.
KIOSK_TOKENS=
# Header-based principals for local development and the dashboard build. Must be
# false in any environment holding real data.
ALLOW_HEADER_AUTH=true

# --- observability ----------------------------------------------------------
LOG_LEVEL=INFO
# JSON in the cloud, where a log processor reads it; false locally, where a
# person does.
LOG_JSON=true
