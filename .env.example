# Copy to .env and set real values. Never commit a filled-in .env.
#
# There is no default password anywhere in this repository. The compose file
# fails to start rather than booting with a known credential.

POSTGRES_USER=medikiosk
POSTGRES_PASSWORD=
POSTGRES_DB=medikiosk
POSTGRES_PORT=5432

REDIS_PORT=6379
NATS_PORT=4222
NATS_MONITOR_PORT=8222

MINIO_ROOT_USER=medikiosk
MINIO_ROOT_PASSWORD=
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

API_PORT=8000
ENVIRONMENT=local
LOG_LEVEL=INFO

# Application config (see backend/app/core/config.py for the full set).
DATABASE_URL=postgresql+asyncpg://medikiosk:CHANGE_ME@localhost:5432/medikiosk
CLINICAL_CONTENT_DIR=./clinical

# source_of_truth | shadow
QUEUE_MODE=source_of_truth
# Off by default. See docs/DECISIONS.md.
PREFER_INTAKE_READY=false
INTAKE_READY_WINDOW=3

# Off by default, and still requires the patient's own raw_audio_retention grant.
RAW_AUDIO_RETENTION_ENABLED=false

# Used only by tests/integration; leave unset to skip the Postgres-only suite.
TEST_DATABASE_URL=
