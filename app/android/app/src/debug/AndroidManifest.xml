<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.

         It is also declared in the main manifest, because a release build needs
         it to submit an intake at all.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Reach a backend running on a laptop over plain HTTP. Debug only: the
         main manifest sets `usesCleartextTraffic="false"`, and this replaces it
         for this build type and no other. -->
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic" />
</manifest>
