Claude outputs/
# Generated by `flutter gen-l10n` into `arb-dir` since Flutter 3.27 (older
# versions wrote them to .dart_tool/flutter_gen/). Paths in this file are
# relative to `app/`, so the old `app/lib/...` spelling matched nothing and
# every build left ten untracked files in `git status`.
lib/l10n/app_localizations*.dart


# Built by tool/asr/build_indicconformer.py — 140 MB per language, reproducible.
assets/asr/indic-hi/
