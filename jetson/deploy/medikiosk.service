[Unit]
Description=MediKiosk voice intake prototype
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/medikiosk
EnvironmentFile=/home/ubuntu/medikiosk/.env
ExecStart=/home/ubuntu/medikiosk/.venv/bin/uvicorn medikiosk.app:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/medikiosk/data

[Install]
WantedBy=multi-user.target

